{
  "name": "unidolor-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo Unidolor: CRM (Alegro X), ChatBot (Cloudflare Workers) y conocimiento",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "sync:knowledge": "tsx scripts/sync-chatbot-knowledge.ts",
    "dev:crm": "pnpm --filter @unidolor/crm-backend dev",
    "dev:chatbot": "pnpm --filter @unidolor/chatbot dev"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  }
}

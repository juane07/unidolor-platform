# Nimbo X API credentials — TEMPLATE ONLY
#
# This file contains NO real values. Copy it to `apps/crm/.env.local` (gitignored)
# and fill in the values there. Never commit a populated copy.
#
#   cp nimbo-credentials.env.example apps/crm/.env.local

# Base URL. Confirm with the provider whether to use staging or production.
NIMBO_BASE_URL=https://api-staging.nimbo.app/api/v1

# Service account username and password.
NIMBO_USERNAME=
NIMBO_PASSWORD=

# Optional: default treating-physician account id.
# NIMBO_DEFAULT_ACCOUNT_ID=

# Optional: organization id, if applicable.
# NIMBO_ORGANIZATION_ID=